# Copy values into Streamlit Community Cloud → App settings → Secrets
# (or local `.streamlit/secrets.toml`; never commit real secrets).

OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"
ASSISTANT_MODE = "openai"

# Optional on-chain anchoring
WEB3_PROVIDER_URL = "https://sepolia.infura.io/v3/<your-project-id>"
CONTRACT_ADDRESS = "0xYourAssuredRegistryAddress"
CHAIN_ID = "11155111"
ACCOUNT_PRIVATE_KEY = "0xYourTestAccountPrivateKey"

# Optional Assured tool URL overrides
ASSURED_DESIGN_URL = "https://assured-design-fair.vercel.app/"
ASSURED_QC_URL = "https://assured-qc-fair.vercel.app/"
ASSURED_HUB_FAIR_URL = "https://assured-hub-fair.vercel.app/"
